msgstr "Zwei Messungen derselben Personen"

#: forum/templates/forum/hangi_test.html:487
#: forum/templates/forum/hangi_test.html:521
msgid "Sürekli veya ordinal bağımlı değişken"
msgstr "Stetige oder ordinale abhängige Variable"

#: forum/templates/forum/hangi_test.html:491
#: forum/templates/forum/hangi_test.html:525
#: forum/templates/forum/hangi_test.html:541
msgid "Friedman"
msgstr "Friedman"

