msgid "Ön Analizler"
msgstr "Voranalysen"

#: istatistik/views.py:26
msgid "Betimleyici İstatistik"
msgstr "Deskriptive Statistik"

#: istatistik/views.py:28
msgid "Örneklem Hesaplayıcı"
msgstr "Stichprobenrechner"

#: istatistik/views.py:30
msgid "Geçerlik & Güvenirlik"
msgstr "Validität & Reliabilität"

#: istatistik/views.py:34
msgid "İlişki Analizleri"
msgstr "Zusammenhangsanalysen"

#: istatistik/views.py:38
