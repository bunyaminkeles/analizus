#: forum/email_utils.py:53
#, python-format
msgid ""
"Merhaba %(owner)s,\n"
"\n"
"\"%(title)s\" ilanınıza %(expert)s teklif verdi!\n"
"\n"
"Teklif: %(price)s TL\n"
"Süre: %(duration)s\n"
"Ön Yazı: %(cover)s\n"
"\n"
"Teklifi görmek ve değerlendirmek için:\n"
"%(url)s\n"
"\n"
"---\n"
"Bu bir otomatik bildirimdir.\n"
"Analizus - Araştırma ve Analiz Platformu"
