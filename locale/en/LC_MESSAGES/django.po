"Hello %(receiver)s,\n"
"\n"
"%(sender)s sent you a new private message!\n"
"\n"
"Message:\n"
"%(excerpt)s...\n"
"\n"
"To read and reply to the message:\n"
"%(url)s\n"
"\n"
"---\n"
"This is an automated notification.\n"
"Analizus - Research and Analysis Platform"

#: forum/email_utils.py:136
#, python-format
msgid "%(author)s sizi bir tartışmada etiketledi"
msgstr "%(author)s mentioned you in a discussion"

#: forum/email_utils.py:138
#, python-format
