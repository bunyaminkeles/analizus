#: forum/email_utils.py:51
#, python-format
msgid "İlanınıza yeni bir teklif geldi: %(title)s"
msgstr "You received a new offer on your listing: %(title)s"

#: forum/email_utils.py:53
#, python-format
msgid ""
"Merhaba %(owner)s,\n"
"\n"
"\"%(title)s\" ilanınıza %(expert)s teklif verdi!\n"
"\n"
"Teklif: %(price)s TL\n"
"Süre: %(duration)s\n"
"Ön Yazı: %(cover)s\n"
"\n"
"Teklifi görmek ve değerlendirmek için:\n"
"%(url)s\n"
"\n"
"---\n"
"Bu bir otomatik bildirimdir.\n"
"Analizus - Araştırma ve Analiz Platformu"
msgstr ""
"Hello %(owner)s,\n"
"\n"
"%(expert)s made an offer on your listing \"%(title)s\"!\n"
"\n"
"Offer: %(price)s TL\n"
"Duration: %(duration)s\n"
"Cover letter: %(cover)s\n"
"\n"
"To view and evaluate the offer:\n"
"%(url)s\n"
"\n"
"---\n"
"This is an automated notification.\n"
"Analizus - Research and Analysis Platform"

#: forum/email_utils.py:82
#, python-format
msgid "%(author)s konunuza cevap yazdı: %(subject)s"
msgstr "%(author)s replied to your topic: %(subject)s"

#: forum/email_utils.py:85
#, python-format
msgid ""
"Merhaba %(starter)s,\n"
"\n"
"\"%(subject)s\" başlıklı konunuza yeni bir cevap geldi!\n"
"\n"
"Cevap Yazan: %(author)s\n"
"Mesaj: %(excerpt)s...\n"
"\n"
"Cevabın tamamını görmek için:\n"
"%(url)s\n"
"\n"
"---\n"
"Bu bir otomatik bildirimdir.\n"
"Analizus - Araştırma ve Analiz Platformu"
msgstr ""
"Hello %(starter)s,\n"
"\n"
"There is a new reply to your topic \"%(subject)s\"!\n"
"\n"
"Replied by: %(author)s\n"
"Message: %(excerpt)s...\n"
"\n"
"To read the full reply:\n"
"%(url)s\n"
"\n"
"---\n"
"This is an automated notification.\n"
"Analizus - Research and Analysis Platform"

#: forum/email_utils.py:111
#, python-format
msgid "%(sender)s size özel mesaj gönderdi"
msgstr "%(sender)s sent you a private message"

#: forum/email_utils.py:113
#, python-format
