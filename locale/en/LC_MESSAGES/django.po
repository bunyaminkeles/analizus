msgid "✓ Model istatistiksel olarak anlamlı (p < .05)"
msgstr "✓ The model is statistically significant (p < .05)"

#: istatistik/templates/istatistik/lineer_regresyon.html:368
#: istatistik/templates/istatistik/lojistik_regresyon.html:371
