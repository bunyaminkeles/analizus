# Bu dosya .env dosyanız için bir şablondur.
# Kendi değerlerinizle doldurup `.env` olarak kaydedin.

# Django
SECRET_KEY=your_secret_key_here
DEBUG=True

# Veritabanı (PostgreSQL önerilir)
DATABASE_URL=postgres://user:password@host:port/dbname

# E-posta (SMTP)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
DEFAULT_FROM_EMAIL="Your Name <your_email@example.com>"

# API Anahtarları (Opsiyonel)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# AWS S3 (Opsiyonel)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Redis (Opsiyonel, Channels için)
REDIS_URL=redis://localhost:6379/0