# AWS SES (Simple Email Service) Configuration
# AWS Console > IAM'den 'ses:SendRawEmail' yetkisine sahip bir kullanıcı oluşturun.
# Zaten S3 için ayarlanmışsa bu değişkenler mevcuttur.
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# E-posta gönderimi yapacağınız AWS bölgesi. Örn: eu-central-1, us-east-1
AWS_SES_REGION_NAME=eu-central-1

# Gönderen e-posta adresi (Bu adres veya domain AWS SES'te doğrulanmalıdır)
AWS_SES_FROM_EMAIL="Analizus" <noreply@analizus.com>

# Database (if using PostgreSQL locally)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security
# SECRET_KEY=your-secret-key-here
GEMINI_API_KEY=YOUR_NEW_API_KEY_HERE
