# Bu dosya .env dosyanız için bir şablondur.
# Kendi değerlerinizle doldurup `.env` olarak kaydedin.

# Django
SECRET_KEY=your_secret_key_here
# Canlı ortamda (Hetzner, Render) False yapın
DEBUG=False
SITE_URL=https://www.analizus.com

# Veritabanı (PostgreSQL önerilir)
# Docker Compose / Hetzner için örnek:
# DATABASE_URL=postgresql://bunyamin:your_password@db:5432/analizus
DATABASE_URL=postgres://user:password@host:port/dbname

# Docker Compose ile yerel PostgreSQL kullanmak isterseniz:
POSTGRES_USER=bunyamin
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=analizus

# Redis (Docker Compose / Hetzner)
# REDIS_URL=redis://redis:6379/0

# E-posta - Resend API (önerilen: Hetzner ve Render)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=info@analizus.com

# E-posta - SMTP (lokal geliştirme, Resend yoksa)
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# API Anahtarları (Opsiyonel)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# AWS S3 (Opsiyonel)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Redis (Opsiyonel, Channels için)
REDIS_URL=redis://localhost:6379/0