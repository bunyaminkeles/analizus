# SendGrid Email Configuration
# SendGrid API Key alın: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.paste_your_api_key_here

# Email gönderen adresi (SendGrid'de doğruladığınız email)
DEFAULT_FROM_EMAIL=YourName <youremail@example.com>

# Database (if using PostgreSQL locally)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security
# SECRET_KEY=your-secret-key-here
GEMINI_API_KEY=YOUR_NEW_API_KEY_HERE

# ═══════════════════════════════════════════════════════════════════════
# TWITTER/X API AYARLARI
# Developer Portal: https://developer.twitter.com
# Free tier: Aylık 1500 tweet yazma hakkı
# ═══════════════════════════════════════════════════════════════════════

# Entegrasyonu aktifleştirmek için 'true' yapın
TWITTER_ENABLED=false

# API Anahtarları (Developer Portal > Keys and Tokens)
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Otomatik paylaşım ayarları (her yeni içerik oluşturulduğunda)
TWITTER_AUTO_SHARE_TOPICS=false
TWITTER_AUTO_SHARE_DAILY_TIPS=false
TWITTER_AUTO_SHARE_JOBS=false
